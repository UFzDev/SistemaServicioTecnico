<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SistemaServicioTecnico</RootNamespace>
    <AssemblyName>SistemaServicioTecnico</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <_TargetFrameworkDirectories>C:\Windows\Microsoft.NET\Framework64\v4.0.30319</_TargetFrameworkDirectories>
    <_FullFrameworkReferenceAssemblyPaths>C:\Windows\Microsoft.NET\Framework64\v4.0.30319</_FullFrameworkReferenceAssemblyPaths>
    <FrameworkPathOverride>C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <Reference Include="System.Xml" />
  </ItemGroup>

</Project>
